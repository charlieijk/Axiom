# Rust build output
/target/
**/*.rs.bk

# Build tool output
/.gradle/
/build/

# Node tooling output (the web/ lint toolchain and site/ both install here)
node_modules/

# Local environment files
.env
.env.*
!.env.example

# Logs and local editor/OS files
*.log
.DS_Store
.idea/
.vscode/

# Python caches and virtual environments
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Local experiment artifacts
checkpoints/

# Notebook results: generated measurements, meaningful only next to the code
# that produced them. Re-run the notebook rather than reading a committed file.
notebooks/results/

# Parquet copies of checkpoint results (regenerate with
# script/export_checkpoints_parquet.py; see docs/duckdb.md)
/exports/

# Local release bundles and intermediate visual QA captures
/release/
/axiom-current-view.png
/*-pass1.png
